# Peal — environment. Copy to .env and fill in. NEVER commit a filled copy.
#
# Live execution is deliberately behind more than one flag. A single
# misconfigured variable must not be able to spend real funds.

# --- core -------------------------------------------------------------------
PEAL_ENVIRONMENT=development           # development | testnet | production
DATABASE_URL=sqlite://bte.db
BTE_DEV=1                              # dev-only conveniences; unset in production
REVEAL_TIMEOUT_SECS=120

# --- committee --------------------------------------------------------------
PEAL_COMMITTEE_SIZE=5
PEAL_THRESHOLD=3
PEAL_BATCH_SIZE=64                     # fixed at ceremony time; 2-4 for local dev
PEAL_BATCH_TIMEOUT=60

# --- metered calls (x402) ---------------------------------------------------
# Where payments for /v1/x402/* land. OPTIONAL: there is a committed default in
# x402.rs, so metered calls work out of the box. Set this only to point a fork
# or a staging environment at a different payee.
#
# Only the ADDRESS goes here: it is public. The private key belongs in a wallet
# and must never reach this file. A malformed value turns the gateway off
# rather than falling back to the default.
#
# Every other PEAL_X402_* variable has a working Tempo Moderato default. See
# docs/deploy-railway.md for the full table.
# PEAL_X402_PAYTO=

# --- private actions --------------------------------------------------------
# Who this coordinator commits batch orderings as. Goes into every receipt, so
# an agent can decide whether it is willing to be ordered by this operator.
# Left unset it reads "unconfigured-executor", which is honest but useless.
PEAL_EXECUTOR_IDENTITY=

PEAL_DEFAULT_CHAIN_ID=560048          # Ethereum Hoodi
PEAL_SUBMISSION_MODE=simulated         # simulated | public-rpc | private | solver

# Both of these must be true before anything can be broadcast for real.
PEAL_EXECUTION_ENABLED=false
PEAL_LIVE_EXECUTION_ENABLED=false

# --- 0x Swap API v2 ---------------------------------------------------------
# Server-side only. This key must never reach a browser bundle.
ZEROX_API_KEY=
ZEROX_BASE_URL=https://api.0x.org

# Addresses this deployment will grant token approvals to, per chain.
# Comma-separated, lowercase. Deliberately NOT hardcoded in library source:
# an allowlist baked into a package is one supply-chain compromise away from
# redirecting every approval, and it rots silently when a venue redeploys.
# Verify each address against 0x's published AllowanceHolder deployment before
# adding it. Never add the Settler contract.
#
# Note the chain id below is 8453 (Base) while PEAL_DEFAULT_CHAIN_ID is Hoodi.
# That is not a mistake: 0x and Across serve mainnets only, so there is no
# Hoodi allowance target to configure and never will be. On Hoodi the swap and
# bridge adapters have nothing to execute against, and submission stays
# `simulated`. See docs/private-actions-gaps.md.
PEAL_TRUSTED_ALLOWANCE_TARGETS_8453=

# --- Across (cross-chain, off by default) -----------------------------------
ACROSS_ENABLED=false
ACROSS_API_KEY=
ACROSS_INTEGRATOR_ID=
ACROSS_BASE_URL=https://app.across.to/api

# --- submission -------------------------------------------------------------
EVM_RPC_URL=
# When empty, an intent that sets privateSubmissionRequired FAILS rather than
# degrading to a public broadcast. That is intentional.
PRIVATE_SUBMISSION_RPC_URL=

# ---- Peal Links (Bonsai private payments) ----
# Node config file (namespaces, params dir, auth domains). The stack script
# writes a filled-in copy to .dev-state/peal-links/config.json.
PEAL_LINKS_CONFIG=config/peal-links.local.json
# Listen address override.
PEAL_LINKS_LISTEN=127.0.0.1:8790
# Development fixture: mounts /links/v1/dev/mint (credits deposit intents
# without a chain event). Never with a mainnet namespace. Default off.
# Local stack only: run the ledger as N Commonware simplex validators
# (decision 0010) instead of one node. 1 = single node.
PEAL_LINKS_VALIDATORS=1
PEAL_LINKS_DEV_MINT=
# Explorer: node origin when not proxied by vite/Caddy (empty = same origin).
VITE_LINKS_URL=
