 syntax: \"*\";\n  inherits: false;\n}\n@property --tw-invert {\n  syntax: \"*\";\n  inherits: false;\n}\n@property --tw-opacity {\n  syntax: \"*\";\n  inherits: false;\n}\n@property --tw-saturate {\n  syntax: \"*\";\n  inherits: false;\n}\n@property --tw-sepia {\n  syntax: \"*\";\n  inherits: false;\n}\n@property --tw-drop-shadow {\n  syntax: \"*\";\n  inherits: false;\n}\n@property --tw-drop-shadow-color {\n  syntax: \"*\";\n  inherits: false;\n}\n@property --tw-drop-shadow-alpha {\n  syntax: \"<percentage>\";\n  inherits: false;\n  initial-value: 100%;\n}\n@property --tw-drop-shadow-size {\n  syntax: \"*\";\n  inherits: false;\n}\n@property --tw-backdrop-blur {\n  syntax: \"*\";\n  inherits: false;\n}\n@property --tw-backdrop-brightness {\n  syntax: \"*\";\n  inherits: false;\n}\n@property --tw-backdrop-contrast {\n  syntax: \"*\";\n  inherits: false;\n}\n@property --tw-backdrop-grayscale {\n  syntax: \"*\";\n  inherits: false;\n}\n@property --tw-backdrop-hue-rotate {\n  syntax: \"*\";\n  inherits: false;\n}\n@property --tw-backdrop-invert {\n  syntax: \"*\";\n  inherits: false;\n}\n@property --tw-backdrop-opacity {\n  syntax: \"*\";\n  inherits: false;\n}\n@property --tw-backdrop-saturate {\n  syntax: \"*\";\n  inherits: false;\n}\n@property --tw-backdrop-sepia {\n  syntax: \"*\";\n  inherits: false;\n}\n@property --tw-duration {\n  syntax: \"*\";\n  inherits: false;\n}\n@property --tw-scale-x {\n  syntax: \"*\";\n  inherits: false;\n  initial-value: 1;\n}\n@property --tw-scale-y {\n  syntax: \"*\";\n  inherits: false;\n  initial-value: 1;\n}\n@property --tw-scale-z {\n  syntax: \"*\";\n  inherits: false;\n  initial-value: 1;\n}\n@layer properties {\n  @supports ((-webkit-hyphens: none) and (not (margin-trim: inline))) or ((-moz-orient: inline) and (not (color:rgb(from red r g b)))) {\n    *, ::before, ::after, ::backdrop {\n      --tw-translate-x: 0;\n      --tw-translate-y: 0;\n      --tw-translate-z: 0;\n      --tw-rotate-x: initial;\n      --tw-rotate-y: initial;\n      --tw-rotate-z: initial;\n      --tw-skew-x: initial;\n      --tw-skew-y: initial;\n      --tw-border-style: solid;\n      --tw-gradient-position: initial;\n      --tw-gradient-from: #0000;\n      --tw-gradient-via: #0000;\n      --tw-gradient-to: #0000;\n      --tw-gradient-stops: initial;\n      --tw-gradient-via-stops: initial;\n      --tw-gradient-from-position: 0%;\n      --tw-gradient-via-position: 50%;\n      --tw-gradient-to-position: 100%;\n      --tw-leading: initial;\n      --tw-font-weight: initial;\n      --tw-tracking: initial;\n      --tw-shadow: 0 0 #0000;\n      --tw-shadow-color: initial;\n      --tw-shadow-alpha: 100%;\n      --tw-inset-shadow: 0 0 #0000;\n      --tw-inset-shadow-color: initial;\n      --tw-inset-shadow-alpha: 100%;\n      --tw-ring-color: initial;\n      --tw-ring-shadow: 0 0 #0000;\n      --tw-inset-ring-color: initial;\n      --tw-inset-ring-shadow: 0 0 #0000;\n      --tw-ring-inset: initial;\n      --tw-ring-offset-width: 0px;\n      --tw-ring-offset-color: #fff;\n      --tw-ring-offset-shadow: 0 0 #0000;\n      --tw-outline-style: solid;\n      --tw-blur: initial;\n      --tw-brightness: initial;\n      --tw-contrast: initial;\n      --tw-grayscale: initial;\n      --tw-hue-rotate: initial;\n      --tw-invert: initial;\n      --tw-opacity: initial;\n      --tw-saturate: initial;\n      --tw-sepia: initial;\n      --tw-drop-shadow: initial;\n      --tw-drop-shadow-color: initial;\n      --tw-drop-shadow-alpha: 100%;\n      --tw-drop-shadow-size: initial;\n      --tw-backdrop-blur: initial;\n      --tw-backdrop-brightness: initial;\n      --tw-backdrop-contrast: initial;\n      --tw-backdrop-grayscale: initial;\n      --tw-backdrop-hue-rotate: initial;\n      --tw-backdrop-invert: initial;\n      --tw-backdrop-opacity: initial;\n      --tw-backdrop-saturate: initial;\n      --tw-backdrop-sepia: initial;\n      --tw-duration: initial;\n      --tw-scale-x: 1;\n      --tw-scale-y: 1;\n      --tw-scale-z: 1;\n    }\n  }\n}\n"],["STYLE",{},"/* Peal Links (#/bonsai, #/bonsai/app, #/pay/:id).\n   Prefix .pl-. Tokens come from style.css; nothing here invents a colour.\n   Display: Josefin Sans (as .hero-title). Body: DM Sans (as .hero-sub). */\n\n.pl {\n  --pl-body: 'DM Sans', 'Satoshi', system-ui, -apple-system, sans-serif;\n  --pl-display: 'Josefin Sans', system-ui, -apple-system, sans-serif;\n  --pl-radius: 14px;\n  --pl-shadow: 0 1px 2px rgb(0 0 0 / 0.05), 0 12px 32px -20px rgb(15 35 70 / 0.25);\n  font-family: var(--pl-body);\n  color: var(--text);\n}\n\n.pl-wrap {\n  max-width: 960px;\n  margin: 0 auto;\n  padding: 0 24px;\n}\n\n@media (max-width: 640px) {\n  .pl-wrap {\n    padding: 0 16px;\n  }\n}\n\n.pl-kicker {\n  font-size: 12px;\n  font-weight: 500;\n  letter-spacing: 0.22em;\n  text-transform: uppercase;\n  color: var(--accent);\n  margin: 0 0 12px;\n}\n\n.pl-h1 {\n  font-family: var(--pl-display);\n  font-weight: 400;\n  font-size: clamp(34px, 5.2vw, 52px);\n  line-height: 1.12;\n  letter-spacing: -0.01em;\n  margin: 0 0 14px;\n  text-wrap: balance;\n}\n\n.pl-h2 {\n  font-family: var(--pl-display);\n  font-weight: 400;\n  font-size: clamp(24px, 3.2vw, 32px);\n  line-height: 1.2;\n  margin: 0 0 8px;\n  text-wrap: balance;\n}\n\n.pl-h3 {\n  font-size: 15px;\n  font-weight: 600;\n  margin: 0 0 4px;\n}\n\n.pl-lead {\n  font-size: 17px;\n  line-height: 1.6;\n  color: #374151;\n  max-width: 540px;\n  margin: 0 0 22px;\n}\n\n.pl-p {\n  font-size: 15px;\n  line-height: 1.7;\n  color: #374151;\n  margin: 0 0 12px;\n}\n\n.pl-muted {\n  color: var(--muted);\n}\n\n.pl-small {\n  font-size: 13px;\n  color: var(--muted);\n  line-height: 1.55;\n}\n\n.pl-mono {\n  font-family: var(--mono);\n  font-size: 12.5px;\n  overflow-wrap: anywhere;\n}\n\n/* ---------- buttons ---------- */\n\n.pl-btn {\n  appearance: none;\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  gap: 8px;\n  font: inherit;\n  font-size: 14px;\n  font-weight: 500;\n  min-height: 44px;\n  padding: 10px 20px;\n  border-radius: 999px;\n  border: 1px solid var(--border);\n  background: rgb(255 255 255 / 0.8);\n  color: var(--text);\n  text-decoration: none;\n  cursor: pointer;\n  transition:\n    background 120ms ease,\n    border-color 120ms ease,\n    transform 100ms ease;\n}\n\n.pl-btn:hover {\n  background: #fff;\n  border-color: #d1d5db;\n}\n\n.pl-btn:active {\n  transform: translateY(1px);\n}\n\n.pl-btn:disabled,\n.pl-btn[aria-disabled='true'] {\n  opacity: 0.55;\n  cursor: not-allowed;\n  pointer-events: none;\n}\n\n.pl-btn-primary {\n  background: var(--accent);\n  border-color: var(--accent);\n  color: #fff;\n}\n\n.pl-btn-primary:hover {\n  background: #1d4ed8;\n  border-color: #1d4ed8;\n}\n\n.pl-btn-block {\n  width: 100%;\n}\n\n/* ---------- landing ---------- */\n\n.pl-hero {\n  display: grid;\n  grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);\n  gap: 40px;\n  align-items: center;\n  padding: 48px 0 56px;\n}\n\n@media (max-width: 820px) {\n  .pl-hero {\n    grid-template-columns: 1fr;\n    gap: 28px;\n    padding: 28px 0 40px;\n  }\n}\n\n.pl-hero-ctas {\n  display: flex;\n  gap: 12px;\n  flex-wrap: wrap;\n}\n\n.pl-product-label {\n  display: inline-flex;\n  align-items: center;\n  gap: 8px;\n  font-size: 12px;\n  font-weight: 500;\n  letter-spacing: 0.08em;\n  text-transform: uppercase;\n  color: var(--muted);\n  margin-bottom: 18px;\n}\n\n.pl-product-label::before {\n  content: '';\n  width: 8px;\n  height: 8px;\n  border-radius: 50%;\n  background: var(--accent);\n}\n\n/* The illustrative checkout beside the hero. Fictional data, says so. */\n.pl-preview {\n  position: relative;\n  border: 1px solid var(--border);\n  border-radius: var(--pl-radius);\n  background: rgb(255 255 255 / 0.85);\n  box-shadow: var(--pl-shadow);\n  padding: 22px 22px 18px;\n  max-width: 420px;\n  justify-self: center;\n  width: 100%;\n}\n\n.pl-preview-tag {\n  position: absolute;\n  top: -10px;\n  right: 16px;\n  font-size: 11px;\n  font-weight: 600;\n  letter-spacing: 0.08em;\n  text-transform: uppercase;\n  color: var(--muted);\n  background: var(--surface);\n  border: 1px solid var(--border);\n  border-radius: 999px;\n  padding: 2px 10px;\n}\n\n.pl-preview-head {\n  display: flex;\n  justify-content: space-between;\n  align-items: baseline;\n  gap: 12px;\n  margin-bottom: 6px;\n}\n\n.pl-preview-name {\n  font-weight: 600;\n}\n\n.pl-preview-title {\n  font-size: 14px;\n  color: #374151;\n  margin: 0 0 14px;\n}\n\n.pl-amount {\n  font-family: var(--pl-display);\n  font-size: 38px;\n  line-height: 1;\n  letter-spacing: -0.01em;\n  font-variant-numeric: tabular-nums;\n}\n\n.pl-amount-unit {\n  font-family: var(--pl-body);\n  font-size: 14px;\n  color: var(--muted);\n  margin-left: 8px;\n}\n\n.pl-preview-rows {\n  margin: 16px 0;\n  border-top: 1px solid var(--border);\n}\n\n.pl-row {\n  display: flex;\n  justify-content: space-between;\n  gap: 12px;\n  padding: 9px 0;\n  border-bottom: 1px solid var(--border);\n  font-size: 13.5px;\n}\n\n.pl-row-label {\n  color: var(--muted);\n}\n\n.pl-row-value {\n  text-align: right;\n  font-variant-numeric: tabular-nums;\n}\n\n.pl-status {\n  display: inline-flex;\n  align-items: center;\n  gap: 7px;\n  font-size: 12.5px;\n  font-weight: 500;\n  border-radius: 999px;\n  padding: 3px 10px;\n  border: 1px solid var(--border);\n  background: var(--surface);\n  color: var(--muted);\n}\n\n.pl-status-dot {\n  width: 7px;\n  height: 7px;\n  border-radius: 50%;\n  background: currentColor;\n}\n\n.pl-status-pending {\n  color: var(--accent);\n  border-color: var(--accent-border);\n  background: var(--accent-weak);\n}\n\n.pl-status-pending .pl-status-dot {\n  animation: pl-pulse 1.2s ease-in-out infinite;\n}\n\n.pl-status-ok {\n  color: #166534;\n  border-color: #bbf7d0;\n  background: var(--green-weak);\n}\n\n.pl-status-bad {\n  color: var(--red-text);\n  border-color: var(--red-border);\n  background: var(--red-weak);\n}\n\n@keyframes pl-pulse {\n  0%,\n  100% {\n    opacity: 0.35;\n  }\n  50% {\n    opacity: 1;\n  }\n}\n\n@media (prefers-reduced-motion: reduce) {\n  .pl-status-pending .pl-status-dot {\n    animation: none;\n  }\n}\n\n.pl-preview-foot {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  flex-wrap: wrap;\n  gap: 8px 12px;\n  margin-top: 12px;\n  font-size: 12px;\n  color: var(--muted);\n}\n\n.pl-preview-steps {\n  display: flex;\n  gap: 6px;\n}\n\n.pl-preview-step {\n  appearance: none;\n  font: inherit;\n  font-size: 12px;\n  padding: 4px 10px;\n  border-radius: 999px;\n  border: 1px solid var(--border);\n  background: #fff;\n  color: var(--muted);\n  cursor: pointer;\n}\n\n.pl-preview-step[aria-pressed='true'] {\n  border-color: var(--accent-border);\n  background: var(--accent-weak);\n  color: var(--accent);\n}\n\n/* sections */\n\n.pl-section {\n  padding: 48px 0;\n  border-top: 1px solid var(--border);\n}\n\n.pl-grid-3 {\n  display: grid;\n  grid-template-columns: repeat(3, minmax(0, 1fr));\n  gap: 16px;\n  margin-top: 22px;\n}\n\n.pl-grid-2 {\n  display: grid;\n  grid-template-columns: repeat(2, minmax(0, 1fr));\n  gap: 16px;\n  margin-top: 22px;\n}\n\n@media (max-width: 720px) {\n  .pl-grid-3,\n  .pl-grid-2 {\n    grid-template-columns: 1fr;\n  }\n}\n\n.pl-card {\n  border: 1px solid var(--border);\n  border-radius: var(--pl-radius);\n  background: rgb(255 255 255 / 0.75);\n  padding: 20px 22px;\n  box-shadow: var(--shadow-hairline, 0 1px 2px rgb(0 0 0 / 0.04));\n}\n\n.pl-card-n {\n  font-size: 11px;\n  font-weight: 700;\n  color: var(--accent);\n  letter-spacing: 0.1em;\n  margin-bottom: 8px;\n}\n\n.pl-card .pl-p:last-child {\n  margin-bottom: 0;\n}\n\n/* privacy table */\n\n.pl-table-wrap {\n  margin-top: 20px;\n  border: 1px solid var(--border);\n  border-radius: var(--pl-radius);\n  background: rgb(255 255 255 / 0.7);\n  overflow-x: auto;\n}\n\n.pl-table {\n  width: 100%;\n  border-collapse: collapse;\n  font-size: 13.5px;\n}\n\n.pl-table th,\n.pl-table td {\n  text-align: left;\n  vertical-align: top;\n  padding: 12px 16px;\n  border-bottom: 1px solid var(--border);\n  line-height: 1.5;\n}\n\n.pl-table th {\n  font-weight: 600;\n  font-size: 12.5px;\n  color: var(--muted);\n  white-space: nowrap;\n}\n\n.pl-table tr:last-child td {\n  border-bottom: 0;\n}\n\n.pl-table td:first-child {\n  font-weight: 500;\n  white-space: nowrap;\n}\n\n@media (max-width: 640px) {\n  /* One card per observer rather than three squeezed columns. */\n  .pl-table thead {\n    display: none;\n  }\n  .pl-table tr {\n    display: block;\n    border-bottom: 1px solid var(--border);\n    padding: 8px 0;\n  }\n  .pl-table tr:last-child {\n    border-bottom: 0;\n  }\n  .pl-table td {\n    display: block;\n    border: 0;\n    padding: 4px 14px;\n    white-space: normal;\n  }\n  .pl-table td::before {\n    content: attr(data-label);\n    display: block;\n    font-size: 11.5px;\n    font-weight: 600;\n    letter-spacing: 0.06em;\n    text-transform: uppercase;\n    color: var(--muted);\n  }\n  .pl-table td:first-child {\n    font-weight: 600;\n    padding-top: 8px;\n  }\n}\n\n/* code */\n\n.pl-code {\n  margin: 16px 0 0;\n  padding: 16px 18px;\n  border-radius: 12px;\n  background: #0f172a;\n  color: #e2e8f0;\n  font-family: var(--mono);\n  font-size: 12.5px;\n  line-height: 1.6;\n  overflow-x: auto;\n  white-space: pre;\n}\n\n.pl-code .c {\n  color: #94a3b8;\n}\n\n/* faq */\n\n.pl-faq {\n  margin-top: 8px;\n}\n\n.pl-faq details {\n  border-bottom: 1px solid var(--border);\n  padding: 4px 0;\n}\n\n.pl-faq summary {\n  cursor: pointer;\n  font-weight: 500;\n  padding: 12px 0;\n  list-style: none;\n  display: flex;\n  justify-content: space-between;\n  gap: 12px;\n}\n\n.pl-faq summary::-webkit-details-marker {\n  display: none;\n}\n\n.pl-faq summary::after {\n  content: '+';\n  color: var(--muted);\n  flex: none;\n}\n\n.pl-faq details[open] summary::after {\n  content: '−';\n}\n\n.pl-faq .pl-p {\n  padding-bottom: 12px;\n}\n\n.pl-attrib {\n  margin-top: 40px;\n  padding-top: 20px;\n  border-top: 1px solid var(--border);\n  font-size: 12.5px;\n  color: var(--muted);\n  line-height: 1.6;\n}\n\n/* ---------- app shell ---------- */\n\n.pl-app {\n  padding: 24px 0 64px;\n}\n\n.pl-app-head {\n  display: flex;\n  justify-content: space-between;\n  align-items: flex-end;\n  gap: 16px;\n  flex-wrap: wrap;\n  margin-bottom: 22px;\n}\n\n.pl-app-title {\n  font-family: var(--pl-display);\n  font-weight: 400;\n  font-size: 30px;\n  margin: 0;\n}\n\n.pl-notice {\n  border: 1px solid var(--border);\n  border-radius: 12px;\n  background: rgb(255 255 255 / 0.7);\n  padding: 14px 16px;\n  font-size: 13.5px;\n  line-height: 1.55;\n  margin-bottom: 18px;\n  overflow-wrap: anywhere;\n}\n\n.pl-notice-warn {\n  border-color: #fde68a;\n  background: #fffbeb;\n  color: #78350f;\n}\n\n.pl-notice-bad {\n  border-color: var(--red-border);\n  background: var(--red-weak);\n  color: var(--red-text);\n}\n\n.pl-notice .pl-code {\n  margin-top: 10px;\n  padding: 10px 12px;\n}\n\n.pl-balances {\n  display: grid;\n  grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));\n  gap: 14px;\n  margin-bottom: 22px;\n}\n\n.pl-balance {\n  border: 1px solid var(--border);\n  border-radius: var(--pl-radius);\n  background: rgb(255 255 255 / 0.8);\n  padding: 16px 18px;\n}\n\n.pl-balance-label {\n  font-size: 12.5px;\n  color: var(--muted);\n  display: flex;\n  justify-content: space-between;\n  gap: 8px;\n}\n\n.pl-balance-amount {\n  font-family: var(--pl-display);\n  font-size: 30px;\n  line-height: 1.1;\n  margin: 8px 0 4px;\n  font-variant-numeric: tabular-nums;\n}\n\n.pl-balance-sub {\n  font-size: 12.5px;\n  color: var(--muted);\n}\n\n.pl-badge {\n  display: inline-block;\n  font-size: 11px;\n  font-weight: 600;\n  letter-spacing: 0.06em;\n  text-transform: uppercase;\n  padding: 2px 8px;\n  border-radius: 999px;\n  border: 1px solid var(--border);\n  color: var(--muted);\n  background: var(--surface);\n}\n\n.pl-badge-demo {\n  border-color: #fde68a;\n  background: #fffbeb;\n  color: #92400e;\n}\n\n.pl-actions {\n  display: flex;\n  gap: 10px;\n  flex-wrap: wrap;\n  margin-bottom: 24px;\n}\n\n.pl-panel {\n  border: 1px solid var(--border);\n  border-radius: var(--pl-radius);\n  background: rgb(255 255 255 / 0.75);\n  margin-bottom: 18px;\n}\n\n.pl-panel-head {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  gap: 12px;\n  padding: 14px 18px;\n  border-bottom: 1px solid var(--border);\n}\n\n.pl-panel-title {\n  font-size: 14px;\n  font-weight: 600;\n  margin: 0;\n}\n\n.pl-empty {\n  padding: 26px 18px;\n  text-align: center;\n  color: var(--muted);\n  font-size: 13.5px;\n  line-height: 1.6;\n}\n\n.pl-list {\n  list-style: none;\n  margin: 0;\n  padding: 0;\n}\n\n.pl-list li {\n  display: grid;\n  grid-template-columns: minmax(0, 1fr) auto;\n  gap: 4px 16px;\n  padding: 12px 18px;\n  border-bottom: 1px solid var(--border);\n  font-size: 13.5px;\n  align-items: center;\n}\n\n.pl-list li:last-child {\n  border-bottom: 0;\n}\n\n.pl-list-main {\n  font-weight: 500;\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.pl-list-sub {\n  grid-column: 1;\n  font-size: 12.5px;\n  color: var(--muted);\n}\n\n.pl-list-side {\n  grid-column: 2;\n  grid-row: 1 / span 2;\n  text-align: right;\n  font-variant-numeric: tabular-nums;\n}\n\n/* ---------- forms ---------- */\n\n.pl-field {\n  display: block;\n  margin-bottom: 14px;\n}\n\n.pl-label {\n  display: block;\n  font-size: 13px;\n  font-weight: 500;\n  margin-bottom: 6px;\n}\n\n.pl-input,\n.pl-select,\n.pl-textarea {\n  width: 100%;\n  font: inherit;\n  font-size: 15px;\n  padding: 10px 12px;\n  min-height: 44px;\n  border: 1px solid var(--border);\n  border-radius: 10px;\n  background: #fff;\n  color: var(--text);\n}\n\n.pl-input:focus,\n.pl-select:focus,\n.pl-textarea:focus {\n  outline: 2px solid var(--accent);\n  outline-offset: 1px;\n  border-color: var(--accent);\n}\n\n.pl-input[aria-invalid='true'] {\n  border-color: var(--red);\n}\n\n.pl-hint {\n  font-size: 12.5px;\n  color: var(--muted);\n  margin-top: 5px;\n}\n\n.pl-error {\n  font-size: 12.5px;\n  color: var(--red-text);\n  margin-top: 5px;\n}\n\n.pl-amount-input {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n}\n\n.pl-amount-input .pl-input {\n  font-variant-numeric: tabular-nums;\n}\n\n/* ---------- checkout ---------- */\n\n.pl-checkout {\n  max-width: 480px;\n  margin: 28px auto 64px;\n  padding: 0 16px;\n}\n\n.pl-checkout-card {\n  border: 1px solid var(--border);\n  border-radius: 18px;\n  background: rgb(255 255 255 / 0.9);\n  box-shadow: var(--pl-shadow);\n  padding: 24px 24px 20px;\n}\n\n.pl-payee {\n  display: flex;\n  align-items: center;\n  gap: 12px;\n  margin-bottom: 14px;\n}\n\n.pl-avatar {\n  width: 40px;\n  height: 40px;\n  border-radius: 50%;\n  background: var(--accent-weak);\n  color: var(--accent);\n  display: grid;\n  place-items: center;\n  font-weight: 600;\n  flex: none;\n}\n\n.pl-payee-name {\n  font-weight: 600;\n}\n\n.pl-payee-assurance {\n  font-size: 12px;\n  color: var(--muted);\n}\n\n.pl-checkout-title {\n  font-size: 15px;\n  color: #374151;\n  margin: 0 0 16px;\n}\n\n.pl-checkout-actions {\n  margin-top: 18px;\n  display: grid;\n  gap: 10px;\n}\n\n.pl-checkout-foot {\n  margin-top: 14px;\n  font-size: 12px;\n  color: var(--muted);\n  line-height: 1.55;\n  text-align: center;\n}\n\n.pl-steps {\n  display: grid;\n  gap: 8px;\n  margin: 16px 0 0;\n  padding: 0;\n  list-style: none;\n}\n\n.pl-step {\n  display: flex;\n  align-items: center;\n  gap: 10px;\n  font-size: 13.5px;\n  color: var(--muted);\n}\n\n.pl-step::before {\n  content: '';\n  width: 8px;\n  height: 8px;\n  border-radius: 50%;\n  border: 1.5px solid var(--border);\n  flex: none;\n}\n\n.pl-step-active {\n  color: var(--text);\n}\n\n.pl-step-active::before {\n  border-color: var(--accent);\n  background: var(--accent);\n}\n\n.pl-step-done {\n  color: var(--text);\n}\n\n.pl-step-done::before {\n  border-color: var(--green);\n  background: var(--green);\n}\n\n/* ---------- dialogs ---------- */\n\n.pl-dialog {\n  border: 1px solid var(--border);\n  border-radius: 16px;\n  padding: 0;\n  max-width: 440px;\n  width: calc(100% - 32px);\n  box-shadow: 0 24px 64px -24px rgb(15 35 70 / 0.4);\n}\n\n.pl-dialog::backdrop {\n  background: rgb(17 24 39 / 0.35);\n  backdrop-filter: blur(4px);\n}\n\n.pl-dialog-body {\n  padding: 22px 22px 18px;\n}\n\n.pl-dialog-title {\n  font-family: var(--pl-display);\n  font-weight: 400;\n  font-size: 22px;\n  margin: 0 0 8px;\n}\n\n.pl-dialog-actions {\n  display: flex;\n  justify-content: flex-end;\n  gap: 10px;\n  margin-top: 18px;\n  flex-wrap: wrap;\n}\n\n/* QR block */\n.pl-qr {\n  display: grid;\n  place-items: center;\n  padding: 12px;\n  background: #fff;\n  border: 1px solid var(--border);\n  border-radius: 12px;\n}\n\n.pl-qr svg {\n  width: 180px;\n  height: 180px;\n}\n\n.pl-share-link {\n  display: flex;\n  gap: 8px;\n  align-items: center;\n}\n\n.pl-share-link .pl-input {\n  min-height: 40px;\n  font-size: 13px;\n}\n\n/* text-style action inside list rows */\n.pl-linkbtn {\n  appearance: none;\n  background: none;\n  border: 0;\n  padding: 0;\n  font: inherit;\n  font-size: inherit;\n  color: var(--accent);\n  cursor: pointer;\n  text-decoration: none;\n}\n\n.pl-linkbtn:hover {\n  text-decoration: underline;\n}\n\n.pl-dialog[open] {\n  animation: pl-dialog-in 160ms ease-out;\n}\n\n@keyframes pl-dialog-in {\n  from {\n    opacity: 0;\n    transform: translateY(6px);\n  }\n  to {\n    opacity: 1;\n    transform: none;\n  }\n}\n\n@media (prefers-reduced-motion: reduce) {\n  .pl-dialog[open] {\n    animation: none;\n  }\n}\n"],["META",{"name":"robots","content":"noindex, nofollow"}],["META",{"name":"referrer","content":"no-referrer"}],["STYLE",{},":root { --privy-color-background: #FFFFFF; --privy-color-background-2: #F1F2F9; --privy-color-background-3: #5B4FFF; --privy-color-foreground: #040217; --privy-color-foreground-2: #64668B; --privy-color-foreground-3: #9498B8; --privy-